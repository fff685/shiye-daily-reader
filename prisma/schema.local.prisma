// Local development schema. Production uses prisma/schema.prisma (PostgreSQL).
// Keep the models in sync when changing fields.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  readingMinutes Int      @default(15)
  autoContinue   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progresses ReadingProgress[]
  sessions   ReadingSession[]
}

model Book {
  id          String   @id @default(cuid())
  source      String   @default("gutenberg")
  sourceId    String
  title       String
  author      String?
  language    String   @default("en")
  description String?
  subjects    String?
  tags        String   @default("[]")
  popularity  Int      @default(0)
  charCount   Int?
  content     String?
  issued      String?
  sourceUrl   String?
  createdAt   DateTime @default(now())

  progresses ReadingProgress[]
  sessions   ReadingSession[]

  @@unique([source, sourceId])
  @@index([language])
  @@index([popularity])
  @@index([title])
}

model ReadingProgress {
  id                String   @id @default(cuid())
  userId            String
  bookId            String
  offset            Int      @default(0)
  dayIndex          Int      @default(0)
  minutesPerSession Int      @default(15)
  totalChars        Int      @default(0)
  totalSeconds      Int      @default(0)
  autoContinue      Boolean  @default(false)
  status            String   @default("reading")
  lastReadAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]

  @@unique([userId, bookId])
  @@index([userId, lastReadAt])
}

model ReadingSession {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  progressId  String
  dayIndex    Int
  chars       Int
  seconds     Int
  completedAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress ReadingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, dayIndex])
  @@index([userId, completedAt])
}
