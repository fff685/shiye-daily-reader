generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  readingMinutes Int      @default(15)
  autoContinue   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  progresses   ReadingProgress[]
  sessions     ReadingSession[]
  importedBooks Book[]           @relation("BookOwner")
}

model Book {
  id          String   @id @default(cuid())
  source      String   @default("gutenberg")
  sourceId    String
  title       String
  author      String?
  language    String   @default("en")
  description String?
  subjects    String?
  tags        String   @default("[]") // JSON string: ["文学", "经典"]
  popularity  Int      @default(0)
  charCount   Int?
  content     String?
  issued      String?
  sourceUrl   String?
  ownerId     String?
  createdAt   DateTime @default(now())

  owner        User?             @relation("BookOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  progresses   ReadingProgress[]
  sessions     ReadingSession[]
  translations Translation[]

  @@unique([source, sourceId])
  @@index([language])
  @@index([popularity])
  @@index([title])
  @@index([ownerId])
}

model Translation {
  id          String   @id @default(cuid())
  bookId      String
  startOffset Int
  endOffset   Int
  targetLang  String   @default("zh")
  paragraphs  String
  createdAt   DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, startOffset, endOffset, targetLang])
  @@index([bookId])
}

model ReadingProgress {
  id                String   @id @default(cuid())
  userId            String
  bookId            String
  offset            Int      @default(0)
  dayIndex          Int      @default(0)
  minutesPerSession Int      @default(15)
  totalChars        Int      @default(0)
  totalSeconds      Int      @default(0)
  autoContinue      Boolean  @default(false)
  status            String   @default("reading") // reading | finished
  lastReadAt        DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sessions ReadingSession[]

  @@unique([userId, bookId])
  @@index([userId, lastReadAt])
}

model ReadingSession {
  id          String   @id @default(cuid())
  userId      String
  bookId      String
  progressId  String
  dayIndex    Int
  chars       Int
  seconds     Int
  completedAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book     Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  progress ReadingProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([progressId, dayIndex])
  @@index([userId, completedAt])
}
