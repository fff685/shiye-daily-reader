{
  "name": "shiye-daily-reader",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --schema prisma/schema.local.prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --schema prisma/schema.local.prisma",
    "import:books": "tsx scripts/import-books.ts",
    "preload:content": "tsx scripts/preload-content.ts",
    "translate:featured": "tsx scripts/translate-featured.ts",
    "vercel-build": "node scripts/prisma-generate.mjs && next build",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "csv-parse": "^6.1.0",
    "jose": "^6.2.16",
    "next": "16.4.5",
    "opencc-js": "^1.4.2",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
